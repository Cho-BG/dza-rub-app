{
  "id": "./admin.html",
  "name": "DZA ⇄ RUB Admin",
  "short_name": "DZA·RUB Admin",
  "description": "Set the RUB price and manage client applications.",
  "start_url": "./admin.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#FCF6ED",
